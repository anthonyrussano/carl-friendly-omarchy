[Admin]
cachePath=@HOME@/.cache/KDE/gcompris-qt
downloadServerUrl=https://cdn.kde.org/gcompris
renderer=auto
userDataPath=@HOME@/.local/share/GCompris

[%General]
audioEffectsVolume=0.7
backgroundMusicVolume=0.2
baseFontSize=0
defaultCursor=false
enableAudioEffects=true
enableAudioVoices=true
enableAutomaticDownloads=false
enableBackgroundMusic=true
exitConfirmation=false
filterLevelMax=2
filterLevelMin=1
font=Andika-R.ttf
fontCapitalization=0
fontLetterSpacing=0
fullscreen=true
homeButtonVisible=true
isCurrentFontEmbedded=true
kiosk=false
locale=system
noCursor=false
sectionVisible=true
virtualKeyboard=false

[Teacher]
teacherId=
teacherPort=65524
