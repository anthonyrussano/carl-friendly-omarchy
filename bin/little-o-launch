#!/usr/bin/env bash
set -euo pipefail

action="${1:-home}"

playroom="$HOME/.local/share/little-o/little-o-playroom.html"
gallery="$HOME/.local/share/little-o/little-o-gallery.py"
music_app="$HOME/.local/share/little-o/little-o-music.py"
chromium_profile="$HOME/.local/share/little-o/chromium-profile"

return_home() {
  omarchy-shell shell summon little-o.home '{}' >/dev/null 2>&1 || true
}

focus_activity_workspace() {
  local reply
  reply="$(hyprctl dispatch 'hl.dsp.focus({ workspace = "10" })' 2>/dev/null || true)"
  if [[ "$reply" != 'ok' ]]; then
    hyprctl dispatch workspace 10 >/dev/null 2>&1 || true
  fi
}

run_and_return() {
  set +e
  uwsm-app -- "$@"
  local status=$?
  set -e
  return_home
  return "$status"
}

launch_playroom() {
  local mode="$1"
  local preferences="$chromium_profile/Default/Preferences"
  local temporary

  mkdir -p "$chromium_profile/Default" "$HOME/Pictures/Carl"
  temporary="$(mktemp "$chromium_profile/Default/Preferences.XXXXXX")"
  if [[ -s "$preferences" ]] && jq empty "$preferences" >/dev/null 2>&1; then
    jq --arg directory "$HOME/Pictures/Carl" \
      '.download = ((.download // {}) + {default_directory: $directory, prompt_for_download: false, directory_upgrade: true})' \
      "$preferences" > "$temporary"
  else
    jq -n --arg directory "$HOME/Pictures/Carl" \
      '{download: {default_directory: $directory, prompt_for_download: false, directory_upgrade: true}}' \
      > "$temporary"
  fi
  mv "$temporary" "$preferences"

  run_and_return chromium \
    --user-data-dir="$chromium_profile" \
    --app="file://${playroom}?mode=${mode}" \
    --start-maximized --no-first-run --no-default-browser-check \
    --disable-background-networking --disable-component-update --disable-sync \
    --disable-extensions --disable-vulkan \
    --disable-features=Translate,MediaRouter
}

launch_gallery() {
  mkdir -p "$HOME/Pictures/Carl"
  if [[ -f "$gallery" ]]; then
    run_and_return python3 "$gallery" "$HOME/Pictures/Carl" \
      --profile "$HOME/.local/share/little-o/gallery-profile"
  else
    notify-send -a "Little O" "Pictures unavailable" "Ask Dad to reinstall Little O."
    return_home
    return 1
  fi
}

case "$action" in
  home)
    omarchy-shell shell summon little-o.home '{}'
    ;;
  draw)
    focus_activity_workspace
    if command -v tuxpaint >/dev/null 2>&1; then
      run_and_return tuxpaint --fullscreen --nosysfonts
    else
      launch_playroom draw
    fi
    ;;
  letters|numbers)
    focus_activity_workspace
    if command -v gcompris-qt >/dev/null 2>&1; then
      if [[ "$action" == "letters" ]]; then
        run_and_return gcompris-qt --launch click_on_letter --difficulty 1-2 --fullscreen --sound --disable-kioskmode
      else
        run_and_return gcompris-qt --launch learn_digits --difficulty 1-2 --fullscreen --sound --disable-kioskmode
      fi
    else
      launch_playroom "$action"
    fi
    ;;
  stories)
    focus_activity_workspace
    mkdir -p "$HOME/Books/Carl"
    if command -v omabook >/dev/null 2>&1; then
      run_and_return omabook
    elif [[ -x "$HOME/.local/share/little-o/omabook/build/omabook" ]]; then
      # Compatibility path for installations made before OmaBook became a
      # pinned submodule and installed `~/.local/bin/omabook`.
      run_and_return "$HOME/.local/share/little-o/omabook/build/omabook"
    else
      notify-send -a "Little O" "Stories unavailable" "Ask Dad to install the pinned OmaBook reader."
      return_home
    fi
    ;;
  music)
    focus_activity_workspace
    mkdir -p "$HOME/Music/Carl"
    if [[ -f "$music_app" ]] && find "$HOME/Music/Carl" -maxdepth 1 -type f \
      \( -iname '*.flac' -o -iname '*.m4a' -o -iname '*.mp3' -o -iname '*.oga' \
      -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.wav' \) -print -quit | grep -q .; then
      run_and_return python3 "$music_app" "$HOME/Music/Carl" \
        --profile "$HOME/.local/share/little-o/music-profile"
    else
      launch_playroom music
    fi
    ;;
  my-things)
    focus_activity_workspace
    launch_gallery
    ;;
  volume)
    omarchy-shell shell toggle omarchy.audio '{}'
    ;;
  grown-ups)
    omarchy-shell shell summon omarchy.menu '{"menu":"root"}'
    ;;
  *)
    notify-send -a "Little O" "Unknown activity" "$action"
    return_home
    exit 2
    ;;
esac
