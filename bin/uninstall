#!/usr/bin/env bash
set -euo pipefail

stamp="$(date +%Y%m%d-%H%M%S)"
archive="$HOME/.local/state/little-o/removed/$stamp"
mkdir -p "$archive"

if [[ "$(omarchy theme current 2>/dev/null || true)" == "Little O" ]]; then
  omarchy theme set "Tokyo Night"
fi

for path in \
  "$HOME/.config/omarchy/plugins/little-o.home" \
  "$HOME/.config/omarchy/themes/little-o" \
  "$HOME/.config/omarchy/hooks/post-boot.d/little-o-home" \
  "$HOME/.local/bin/little-o-launch" \
  "$HOME/.local/share/little-o/little-o-playroom.html"; do
  [[ -e "$path" ]] && mv "$path" "$archive/"
done

latest_shell="$(find "$HOME/.local/state/little-o/backups" -type f -name shell.json -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"
if [[ -n "$latest_shell" ]]; then
  cp "$latest_shell" "$HOME/.config/omarchy/shell.json"
else
  printf 'No installer-created shell backup was found; shell.json was left unchanged.\n' >&2
fi

omarchy restart shell
printf 'Little O files moved to %s (recoverable).\n' "$archive"
printf 'Books, music, pictures, OmaBook data, and Hermes data were preserved.\n'
